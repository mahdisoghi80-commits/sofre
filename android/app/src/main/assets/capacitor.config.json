{
	"appId": "ir.sofreh.mealplanner",
	"appName": "سفره",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"iosScheme": "https"
	},
	"android": {
		"allowMixedContent": true,
		"backgroundColor": "#FBF5EF"
	},
	"ios": {
		"backgroundColor": "#FBF5EF",
		"contentInset": "automatic"
	},
	"plugins": {
		"CapacitorHttp": {
			"enabled": true
		},
		"SplashScreen": {
			"launchShowDuration": 1000,
			"backgroundColor": "#FBF5EF",
			"showSpinner": false
		}
	}
}

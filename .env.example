# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="AQ.Ab8RN6JVXvBrJkBNRbfh_8R4TAcinK3zPT4Yx3DkFkzdSitA1w"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Optional override for native Android/iOS Capacitor builds
# pointing to the hosted Sofreh backend where GEMINI_API_BASE_URL / GEMINI_API_KEY is configured.
VITE_API_BASE_URL=""

# VITE_PRICES_URL: Optional external JSON URL (e.g. GitHub Raw URL to public/prices-live.json)
# for fetching automated live Iranian grocery prices directly in web/APK builds.
VITE_PRICES_URL=""
